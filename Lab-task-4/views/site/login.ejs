<div class="auth-page">
  <div class="auth-card narrow">
    <h2 
      class="auth-title"
    >
      Login
    </h2>

    <form action="" method="POST">
      <div class="auth-field">
        <label 
          class="auth-label"
        >
          Email
        </label>

        <input 
          type="text" 
          name="email" 
          value="admin@admin.com"
          class="auth-input"
        />
      </div>
      <div class="auth-field wide">
        <label 
          class="auth-label"
        >
          Password
        </label>

        <input 
          type="password" 
          name="password" 
          value="admin"
          class="auth-input"
        />
      </div>
      <button
        type="submit"
        class="auth-button primary"
      >
        Login
      </button>

    </form>
  </div>
</div>
