<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/stylesheets/superadmin.css" />

</head>
<body>
  <nav class="admin-navbar">

    <a href="/" class="admin-logo">MyApp</a>

    <div class="admin-links">
      <a href="/" class="admin-link">Main Site</a>
      <a href="/super-admin/products" class="admin-link">Products</a>
      <a href="/super-admin/categories" class="admin-link">Categories</a>
      <a href="/super-admin" class="admin-link">Dashboard</a>
    </div>

  </nav>
  <% if(typeof(flash)!="undefined")
    {%>
    <div class="alert alert-<%= flash.type %> center-block m-2">
      <%= flash.message %>
    </div>
    <% }%>

  <div class="container mt-4">
    <%- body %>
  </div>

  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
  ></script>

</body>
</html>
